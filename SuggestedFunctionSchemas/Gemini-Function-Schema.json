{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the function."
    },
    "signature": {
      "type": "string",
      "description": "The function signature, including return type and parameter types.  Use TypeScript syntax."
    },
    "description": {
      "type": "object",
      "properties": {
        "brief": {
          "type": "string",
          "description": "A concise overview of the function's purpose."
        },
        "detailed": {
          "type": "string",
          "description": "A comprehensive explanation of the function's logic, including parameter type variations, conditional behaviors, and return value variations.  Use Markdown for formatting, including code blocks for illustrating logic branches."
        }
      },
      "required": ["brief", "detailed"]
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "array",
            "items": {
              "type": "string"
            },
             "minItems": 1
          },
          "defaultValue": {
             "oneOf": [
               {"type": "string"},
               {"type": "number"},
               {"type": "boolean"},
               {"type": "null"} 
             ]
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the parameter, its impact on the function's behavior based on type and value, and any constraints."
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": ["name", "type", "description"] 
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedFunctions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["name", "description"]
      }
    },
    "exampleUsages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["description", "code"]
      },
      "description": "Comprehensive examples demonstrating various parameter combinations, types, and resulting behaviors. Use Markdown for formatting and code blocks."
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "errorType": { "type": "string" },
          "condition": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["errorType", "condition", "message"]
      }
    },
    "return": {
      "type": "object",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of each possible return type, its meaning, and the conditions that lead to it being returned."
        }
      },
      "required": ["types", "description"]
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of external dependencies (packages, modules, functions)."
    },
    "notes": {
      "type": "string"
    },
    "todos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edgeCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario": { "type": "string" },
          "behavior": { "type": "string" },
          "example": { "type": "string" }
        },
        "required": ["scenario", "behavior"]
      },
      "description": "Thorough exploration of potential edge cases, their behavior, and examples."
    }
  },
  "required": [
    "name", "signature", "description", "params", "return"
  ] 
}

